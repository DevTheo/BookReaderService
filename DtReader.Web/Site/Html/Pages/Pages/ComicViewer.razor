@page "/ComicViewer"
@rendermode InteractiveServer

<PageTitle>@ComicName</PageTitle>
<HeadContent>
    <link rel="preload" href="/wwwroot/scripts/spotlight.bundle.js" as="script">
</HeadContent>

<div class="spotlight-group">
    @for (var i = 0; i < PageCount; i++)
    {
        <a class="spotlight" href=@($"/api/comic-viewer?name={FileName}&page={i}")>
            <img src=@($"/api/comic-viewer?name={FileName}&page={i}") />
        </a>
    }
</div>

@code
{
    [Parameter] public string ComicName { get; set; } = "WHIZ Comics 001";
    [Parameter] public string FileName { get; set; } = "WHIZ Comics 001.cbz";
    [Parameter] public int PageCount { get; set; } = 68;
}
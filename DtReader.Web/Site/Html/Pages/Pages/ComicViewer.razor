@page "/ComicViewer"
@using System.Text.Json
@using DtReader.Web.Site.Html.Widgets
@rendermode InteractiveServer

<PageTitle>@ComicName</PageTitle>

<ImageViewer FileName=@FileName PageCount=@PageCount />

@code
{
    [Parameter] public string FileName { get; set; } = "WHIZ Comics 001.cbz";
    [Parameter] public int PageCount { get; set; } = 68;
    internal string ComicName => Path.GetFileNameWithoutExtension(FileName);
}